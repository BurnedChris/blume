---
// The guides index (/guides): a left-aligned two-tone heading, a row of
// links to each section, then every guide in its section (`sections` in
// guides.ts: one per area, like migration or hosting), each a grid of swatch
// cards, then the install CTA. The list is also emitted as
// schema.org ItemList structured data, so search and answer engines read it
// as a collection of the guides it links to.
import PageLayout from "blume/components/layout/PageLayout.astro";
import { componentSlug } from "blume/components/slug.ts";
import data from "blume:data";
import GuideGrid from "../_guides/GuideGrid.astro";
import { guides, sections } from "../_guides/guides.ts";
import Footer from "../_home/Footer.astro";
import InstallCta from "../_home/InstallCta.astro";
import Motion from "../_home/Motion.astro";
import { installCopyScript } from "../_home/shared.ts";

const { config } = data;
const pageTitle = "Blume guides";
const pageDescription =
  "Step-by-step guides to getting things done with Blume, from deploying your docs to opening them up to AI agents.";
const groups = sections
  .map((section) => ({
    guides: guides.filter((guide) => section.topics.includes(guide.topic)),
    id: componentSlug(section.title),
    title: section.title,
  }))
  .filter((group) => group.guides.length > 0);
const itemList = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: guides.map((guide, index) => ({
    "@type": "ListItem",
    name: guide.title,
    position: index + 1,
    url: config.site
      ? new URL(`/guides/${guide.id}`, config.site).href
      : `/guides/${guide.id}`,
  })),
  name: pageTitle,
}).replaceAll("<", "\\u003c");
---

<PageLayout
  analytics={config.analytics}
  banner={config.banner}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  page={{ description: pageDescription, route: "/guides", title: pageTitle }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  siteUrl={config.site}
  structuredDataEnabled={config.structuredData}
  themeMode={config.theme.mode}
  x={config.x}
>
  <div
    class="mx-auto grid max-w-[1400px] gap-24 px-6 pb-20 sm:pb-24 lg:gap-32 xl:gap-40"
  >
    <div class="flex flex-col gap-12 pt-16 sm:pt-24 lg:gap-16">
      <h1 class="max-w-[30ch] text-balance font-medium text-4xl sm:text-5xl">
        <span class="block">Guides.</span>
        <span class="block text-muted-foreground">One goal at a time.</span>
      </h1>

      <nav aria-label="Guide sections" class="border-border border-b pb-4">
        <ul
          class="flex flex-wrap gap-x-5 gap-y-2 text-base sm:text-sm"
          role="list"
        >
          {
            groups.map((group) => (
              <li>
                <a
                  class="text-muted-foreground hover:text-foreground"
                  href={`#${group.id}`}
                >
                  {group.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        groups.map((group, index) => (
          <section
            aria-labelledby={group.id}
            class:list={[
              "flex scroll-mt-24 flex-col gap-10",
              // The section links' underline divides the first section
              index > 0 && "border-border border-t pt-12 lg:pt-16",
            ]}
            data-reveal
          >
            <h2
              class="text-balance font-medium text-2xl text-foreground sm:text-3xl"
              id={group.id}
            >
              {group.title}
            </h2>
            <GuideGrid guides={group.guides} level="h3" />
          </section>
        ))
      }
    </div>

    <InstallCta />
  </div>
  <!-- After the sections, so their reveal containers exist when it arms -->
  <Motion />
  <script is:inline set:html={installCopyScript} />
  {
    config.structuredData && (
      <script is:inline set:html={itemList} type="application/ld+json" />
    )
  }
  <Footer slot="footer" />
</PageLayout>
